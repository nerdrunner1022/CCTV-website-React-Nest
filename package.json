{
  "name": "cctv-platform",
  "version": "0.0.0",
  "private": true,
  "description": "CCTV shop website — lead engine, catalog, and customer portal.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "node scripts/dev.mjs",
    "dev:apps": "pnpm -r --parallel run dev",
    "db:up": "node scripts/local-db.mjs up",
    "db:down": "node scripts/local-db.mjs down",
    "db:reset": "node scripts/local-db.mjs reset",
    "db:status": "node scripts/local-db.mjs status",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
