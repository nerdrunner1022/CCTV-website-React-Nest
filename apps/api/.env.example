# --- Database (Neon) -------------------------------------------------------
# Pooled connection string — used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection string — used only for migrations (prisma migrate).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- App -------------------------------------------------------------------
PORT=3000
CORS_ORIGINS="http://localhost:5173"

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="CCTV Shop <no-reply@example.com>"
STAFF_ALERT_EMAIL="sales@example.com"

# --- Jobs (Upstash QStash) -------------------------------------------------
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
PUBLIC_API_URL="http://localhost:3000/api"

# --- Files (Cloudflare R2 / S3-compatible) ---------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="cctv-uploads"
R2_PUBLIC_URL=""

# --- Messaging (WhatsApp click-to-chat) ------------------------------------
WHATSAPP_NUMBER="15551234567"
GOOGLE_REVIEW_URL=""
