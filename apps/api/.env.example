# --- Database (local dev) --------------------------------------------------
# Embedded PostgreSQL started with `pnpm db:up` (or automatically by `pnpm dev`).
# Data persists under .local/pgdata — `pnpm db:reset` wipes it.
# To use Neon instead: paste the pooled URL into DATABASE_URL and the direct
# URL into DIRECT_URL (not needed for local development).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cctv"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cctv"

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- App -------------------------------------------------------------------
PORT=3000
CORS_ORIGINS="http://localhost:5173"

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="CCTV Shop <no-reply@example.com>"
STAFF_ALERT_EMAIL="sales@example.com"

# --- Jobs (Upstash QStash) -------------------------------------------------
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
PUBLIC_API_URL="http://localhost:3000/api"

# --- Files (Cloudflare R2 / S3-compatible) ---------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="cctv-uploads"
R2_PUBLIC_URL=""

# --- Messaging (WhatsApp click-to-chat) ------------------------------------
WHATSAPP_NUMBER="15551234567"
GOOGLE_REVIEW_URL=""
